@startuml
' Diagrama de classes — Gerenciador de Treinos (níveis 1 a 3)
' Para editar: cole este texto em https://www.plantuml.com/plantuml

skinparam classAttributeIconSize 0
hide empty members

abstract class Pessoa {
  - nome: str
  - cpf: str
  - idade: int
  + {abstract} apresentar(): str
}

class Aluno {
  - peso_kg: float
  - altura_m: float
  + fichas: list[FichaTreino]
  + sessoes: list[SessaoTreino]
  + calcular_imc(): float
  + adicionar_ficha(ficha)
  + remover_ficha(nome)
  + buscar_ficha(nome): FichaTreino
  + registrar_sessao(sessao)
  + apresentar(): str
}

class Instrutor {
  - cref: str
  + alunos: list[Aluno]
  + vincular_aluno(aluno)
  + desvincular_aluno(cpf)
  + buscar_aluno(cpf): Aluno
  + apresentar(): str
}

abstract class Exercicio {
  + nome: str
  + grupo_muscular: str
  + {abstract} calcular_volume(): float
  + {abstract} descricao(): str
  + descrever_registro(series, repeticoes, carga_kg): str
}

class ExercicioMusculacao {
  + series: int
  + repeticoes: int
  + carga_kg: float
  + calcular_volume(): float
  + descricao(): str
}

class ExercicioCardio {
  + duracao_min: float
  + distancia_km: float
  + calcular_volume(): float
  + descricao(): str
  + descrever_registro(series, repeticoes, carga_kg): str
}

class ExercicioIsometrico {
  + series: int
  + tempo_s: float
  + calcular_volume(): float
  + descricao(): str
  + descrever_registro(series, repeticoes, carga_kg): str
}

class FichaTreino {
  + nome: str
  - _exercicios: list[Exercicio]
  + adicionar_musculacao(...): ExercicioMusculacao
  + adicionar_cardio(...): ExercicioCardio
  + adicionar_isometrico(...): ExercicioIsometrico
  + remover_exercicio(nome)
  + buscar_exercicio(nome): Exercicio
  + calcular_volume_total(): float
  + descricao(): str
}

class SessaoTreino {
  + data: date
  + ficha: FichaTreino
  + duracao_min: float
  + observacao: str
  - _registros: list[RegistroExercicio]
  + registrar_exercicio(nome, series, repeticoes, carga_kg): RegistroExercicio
  + adicionar_registro(exercicio, series, repeticoes, carga_kg): RegistroExercicio
  + calcular_volume_total(): float
  + resumo(): str
}

class RegistroExercicio {
  + exercicio: Exercicio
  + series: int
  + repeticoes: int
  + carga_kg: float
  + calcular_volume(): float
  + descricao(): str
}

class RelatorioEvolucao {
  + evolucao_carga(sessoes, nome_exercicio): list
  + variacao_carga(sessoes, nome_exercicio): float
  + volume_por_semana(sessoes): dict
  + classificar_imc(aluno): tuple
}

class RepositorioMemoria {
  - _alunos: list[Aluno]
  - _instrutores: list[Instrutor]
  + adicionar_aluno(aluno)
  + atualizar_aluno(aluno)
  + remover_aluno(cpf)
  + adicionar_instrutor(instrutor)
  + remover_instrutor(cpf)
  + vincular(instrutor, aluno)
  + desvincular(instrutor, aluno)
  + adicionar_ficha(aluno, ficha)
  + remover_ficha(aluno, ficha)
  + salvar_exercicio(ficha, exercicio)
  + remover_exercicio(ficha, exercicio)
  + registrar_sessao(aluno, sessao)
  + descricao(): str
  + fechar()
}

class RepositorioSQLite {
  + caminho: str
  + conexao: sqlite3.Connection
  - _ids: dict
  - _carregar()
  - _montar_exercicio(ficha, linha): Exercicio
  - _inserir_exercicio(ficha, exercicio)
  + (sobrescreve os métodos que alteram dados)
}

class MenuTerminal {
  + repo: RepositorioMemoria
  + relatorio: RelatorioEvolucao
  + executar()
}

' Herança
RepositorioMemoria <|-- RepositorioSQLite
Pessoa <|-- Aluno
Pessoa <|-- Instrutor
Exercicio <|-- ExercicioMusculacao
Exercicio <|-- ExercicioCardio
Exercicio <|-- ExercicioIsometrico

' Composição
FichaTreino *-- "0..*" Exercicio : contém
SessaoTreino *-- "0..*" RegistroExercicio : contém

' Associação
Instrutor "0..1" --> "0..*" Aluno : acompanha
Aluno "1" --> "0..*" FichaTreino : tem
Aluno "1" --> "0..*" SessaoTreino : fez
SessaoTreino "0..*" --> "1" FichaTreino : realizou
RegistroExercicio "0..*" --> "1" Exercicio : refere-se a

RepositorioMemoria "1" --> "0..*" Aluno : guarda
RepositorioMemoria "1" --> "0..*" Instrutor : guarda
MenuTerminal --> RepositorioMemoria : usa
MenuTerminal --> RelatorioEvolucao : usa

' Dependência
RelatorioEvolucao ..> SessaoTreino : usa
RelatorioEvolucao ..> Aluno : usa

note bottom of Exercicio
  Polimorfismo: cada subclasse
  sobrescreve calcular_volume(),
  descricao() e descrever_registro().
end note

note right of RepositorioSQLite
  Nível 3: cada método chama super()
  (altera os objetos) e depois grava
  no SQLite (INSERT, UPDATE, DELETE).
  O menu funciona igual com os dois
  repositórios (polimorfismo).
end note

note top of Pessoa
  Polimorfismo: Aluno e Instrutor
  sobrescrevem apresentar().
end note
@enduml
